# Copy to .env.local for `npm run dev` / `npm run build` / `npm run preview`.
# On Workers Builds, set these as *build variables* (they are inlined at build time).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: public site URL for sitemap, share links and the QR code
# (defaults to https://dan3d.jailabs.com.br).
# NEXT_PUBLIC_SITE_URL=https://dan3d.jailabs.com.br
