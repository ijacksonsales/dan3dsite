{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "dan3d",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference service binding, the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dan3d",
    },
  ],
  // Custom Domain: Cloudflare creates the DNS record and the certificate.
  // The jailabs.com.br zone must be on this account (PLAN.md §2).
  "routes": [{ "pattern": "dan3d.jailabs.com.br", "custom_domain": true }],
  // Keep *.workers.dev and per-version preview URLs for HTTPS/AR testing (PLAN.md §6.4).
  "workers_dev": true,
  "preview_urls": true,
  // Run the Worker next to Supabase (AWS us-west-2, Oregon): each page makes
  // several queries, so one long hop for the HTML beats one per query.
  // Static assets are still served from the edge. See docs/decisions.md.
  "placement": { "mode": "targeted", "region": "aws:us-west-2" },
  "observability": {
    "enabled": true,
  },
  // Public vars (NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY) are
  // inlined at build time from .env / Workers Builds build variables.
  // SUPABASE_SERVICE_ROLE_KEY is a secret: `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`.
}
